<aside class="sources" aria-label="原文">
  <p class="sources__label">原文</p>
  <ul>
{% for source in post.sources %}
    <li><a href="{{ source.url }}">{{ source.title }}</a>{% if source.publisher or source.date %}<span class="sources__meta">{{ source.publisher or "" }}{% if source.publisher and source.date %} · {% endif %}{% if source.date %}{{ source.date.isoformat() }}{% endif %}</span>{% endif %}</li>
{% endfor %}
  </ul>
</aside>
<div class="content">
{{ content|safe }}
</div>
