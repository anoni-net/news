<article class="brief">
  <h3 class="brief__title"><a href="{{ url(post.rel) }}"{% if front is defined and front %}{{ track("home-story-click", section="timeline") }}{% endif %}>{{ post.title }}</a></h3>
  <p class="brief__dek">{{ post.description }}</p>
{% set line = post|source_line %}
{% if line %}
  <p class="brief__source">{{ line }}</p>
{% endif %}
</article>
