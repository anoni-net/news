{# 另外兩個語系的同一頁，目前的語系不列。頁尾與文章頁的署名下方共用，langs_class 決定樣式 #}
{% set others = alternates|rejectattr("current")|list %}
{% if others %}
<p class="{{ langs_class }}">{{ icon('translate') }} {{ s.other_langs }}{% for alt in others %}<a href="{{ alt.href }}" hreflang="{{ alt.html }}" lang="{{ alt.html }}">{{ alt.name }}</a>{% if not loop.last %}{{ s.list_sep }}{% endif %}{% endfor %}</p>
{% endif %}
