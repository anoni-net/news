{# 導讀歷史的快照放在當天導讀的後面，只放標題與一句 description，全文在日期頁。
   新聞導讀是主線，這一則是點綴，字級與用色都比導讀低一階 #}
<article class="past">
  <p class="past__label"><a href="{{ url(home ~ 'history/') }}">{{ icon('history') }} {{ s.history }}</a><span aria-hidden="true"> · </span><time datetime="{{ snap.event.isoformat() }}">{{ s.history_event_year.format(year=snap.event.year) }}</time></p>
  <h3 class="past__title"><a href="{{ url(snap.rel) }}#{{ snap.anchor }}">{{ snap.title }}</a></h3>
  <p class="past__dek">{{ snap.description }}</p>
</article>
