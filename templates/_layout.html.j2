<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<meta name="description" content="{{ page_description }}">
{% if noindex %}
<meta name="robots" content="noindex, follow">
{% endif %}
<link rel="canonical" href="{{ page_url }}">
{% if onion_url %}
<meta http-equiv="onion-location" content="{{ onion_url }}">
{% endif %}
<link rel="stylesheet" href="{{ url('css/news.css') }}">
<link rel="icon" href="{{ url('favicon.svg') }}" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="anoni.net 新聞導讀" href="{{ target.abs_url('feed.xml') }}">
<meta property="og:site_name" content="anoni.net 新聞導讀">
<meta property="og:locale" content="zh_TW">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:description" content="{{ page_description }}">
<meta property="og:url" content="{{ page_url }}">
{% if og_image %}
<meta property="og:image" content="{{ og_image }}">
{% else %}
<meta property="og:image" content="{{ target.abs_url('og.png') }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{% endif %}
<meta name="twitter:card" content="summary_large_image">
{% block head %}{% endblock %}
</head>
<body>
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="{{ config.homepage }}"><img src="{{ url('logo-wordmark-white.svg') }}" alt="anoni.net" width="116" height="28"></a>
    <a class="site-header__product" href="{{ url() }}">新聞導讀</a>
  </div>
{% block masthead %}{% endblock %}
</header>
<main class="{% block main_class %}wrap{% endblock %}">
{% block content %}{% endblock %}
</main>
<footer class="site-footer">
  <div class="wrap">
    <nav class="site-footer__links" aria-label="頁尾">
      <a href="{{ url('feed.xml') }}">RSS</a>
      <a href="{{ config.newsletter }}">訂閱電子報</a>
      <a href="{{ config.homepage }}">anoni.net 首頁</a>
{% if onion_url %}
      <a href="{{ onion_url }}">onion 版本</a>
{% endif %}
    </nav>
    <p>文章以 <a href="{{ config.license }}">CC-BY 4.0</a> 授權，引用的原文著作權屬於原作者。</p>
  </div>
</footer>
</body>
</html>
