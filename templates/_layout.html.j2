<!DOCTYPE html>
<html lang="{{ lang.html }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<meta name="description" content="{{ page_description }}">
{% if noindex %}
<meta name="robots" content="noindex, follow">
{% endif %}
<link rel="canonical" href="{{ page_url }}">
{% for alt in alternates %}
<link rel="alternate" hreflang="{{ alt.html }}" href="{{ alt.abs }}">
{% endfor %}
{% if alternates %}
<link rel="alternate" hreflang="x-default" href="{{ alternates[0].abs }}">
{% endif %}
{% if onion_url %}
<meta http-equiv="onion-location" content="{{ onion_url }}">
{% endif %}
<link rel="stylesheet" href="{{ asset('css/news.css') }}">
<link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="{{ s.site_name }}" href="{{ target.abs_url(home ~ 'feed.xml') }}">
<meta property="og:site_name" content="{{ s.site_name }}">
<meta property="og:locale" content="{{ lang.og_locale }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:description" content="{{ page_description }}">
<meta property="og:url" content="{{ page_url }}">
{% if og_image %}
<meta property="og:image" content="{{ og_image }}">
{% if og_card %}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{% endif %}
{% else %}
<meta property="og:image" content="{{ abs_asset(lang.og_image) }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{% endif %}
{# 預覽圖的替代文字：這一頁自己的圖（預覽卡片或指定的 image）寫頁面標題，全站共用的那張寫站名 #}
<meta property="og:image:alt" content="{{ og_title if og_image else s.site_name }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image:alt" content="{{ og_title if og_image else s.site_name }}">
{% block head %}{% endblock %}
{% if target.analytics %}
{% include "_analytics.html.j2" %}
{% endif %}
</head>
<body>
<header class="site-header">
  <div class="site-header__inner">
    {# 標誌與產品名是同一個連結，回到本語系的 news 首頁。官網首頁的入口在頁尾 #}
    <a class="site-header__home" href="{{ url(home) }}"><img class="site-header__logo" src="{{ asset('logo-wordmark-white.svg') }}" alt="anoni.net" width="116" height="28"> <span class="site-header__product">{{ s.product }}</span></a>
{% block header_langs %}
{% set header_langs = alternates|rejectattr("current")|list %}
{% if header_langs %}
    {# 頁首右側的語系切換，用簡稱放得進手機的一列，完整名稱寫在 aria-label，朗讀時念得出來。
       文章頁與單頁在標題區已經有「其他語言」那一行，覆寫成空的 block，不重複放 #}
    <nav class="site-header__langs" role="navigation" aria-label="{{ s.other_langs_label }}">{{ icon('translate') }}{% for alt in header_langs %}<a href="{{ alt.href }}" hreflang="{{ alt.html }}" lang="{{ alt.html }}" aria-label="{{ alt.name }}">{{ alt.short }}</a>{% endfor %}</nav>
{% endif %}
{% endblock %}
  </div>
{% block masthead %}{% endblock %}
</header>
<main class="{% block main_class %}wrap{% endblock %}">
{% block content %}{% endblock %}
</main>
<footer class="site-footer">
  <div class="wrap">
    <nav class="site-footer__links" aria-label="{{ s.footer_label }}">
      <a href="{{ url(home ~ 'subscribe/') }}"{{ track("subscribe-click", channel="rss", where="footer") }}>{{ icon('rss') }} {{ s.rss }}</a>
      <a href="{{ s.newsletter_url }}"{{ track("subscribe-click", channel="newsletter", where="footer") }}>{{ icon('email-outline') }} {{ s.newsletter }}</a>
      <a href="{{ s.bluesky_url }}"{{ track("subscribe-click", channel="bluesky", where="footer") }}>{{ icon('bluesky') }} {{ s.bluesky }}</a>
      <a href="{{ url(home ~ 'history/') }}">{{ icon('history') }} {{ s.history }}</a>
      <a href="{{ url(home ~ 'about/') }}">{{ icon('information-outline') }} {{ s.about }}</a>
      <a href="{{ url(home ~ 'reading/') }}">{{ icon('book-open-outline') }} {{ s.reading }}</a>
      <a href="{{ s.report_url }}">{{ icon('message-alert-outline') }} {{ s.report }}</a>
      <a href="{{ config.homepage }}">{{ icon('home-outline') }} {{ s.home }}</a>
{% if onion_url %}
      <a href="{{ onion_url }}">{{ icon('torproject') }} {{ s.onion }}</a>
{% endif %}
    </nav>
{% with langs_class = "site-footer__langs" %}{% include "_other_langs.html.j2" %}{% endwith %}
    <p>{{ s.license_before }}<a href="{{ s.license_url }}">CC-BY 4.0</a>{{ s.license_after }}</p>
{% if target.analytics %}
    <p>{{ s.analytics }}</p>
{% endif %}
  </div>
</footer>
</body>
</html>
