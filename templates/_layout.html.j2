<!DOCTYPE html>
<html lang="{{ lang.html }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<meta name="description" content="{{ page_description }}">
{% if noindex %}
<meta name="robots" content="noindex, follow">
{% endif %}
<link rel="canonical" href="{{ page_url }}">
{% for alt in alternates %}
<link rel="alternate" hreflang="{{ alt.html }}" href="{{ alt.abs }}">
{% endfor %}
{% if alternates %}
<link rel="alternate" hreflang="x-default" href="{{ alternates[0].abs }}">
{% endif %}
{% if onion_url %}
<meta http-equiv="onion-location" content="{{ onion_url }}">
{% endif %}
<link rel="stylesheet" href="{{ url('css/news.css') }}">
<link rel="icon" href="{{ url('favicon.svg') }}" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="{{ s.site_name }}" href="{{ target.abs_url(home ~ 'feed.xml') }}">
<meta property="og:site_name" content="{{ s.site_name }}">
<meta property="og:locale" content="{{ lang.og_locale }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:description" content="{{ page_description }}">
<meta property="og:url" content="{{ page_url }}">
{% if og_image %}
<meta property="og:image" content="{{ og_image }}">
{% else %}
<meta property="og:image" content="{{ target.abs_url(lang.og_image) }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{% endif %}
<meta name="twitter:card" content="summary_large_image">
{% block head %}{% endblock %}
{% if target.analytics %}
{% include "_analytics.html.j2" %}
{% endif %}
</head>
<body>
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="{{ config.homepage }}"><img src="{{ url('logo-wordmark-white.svg') }}" alt="anoni.net" width="116" height="28"></a>
    <a class="site-header__product" href="{{ url(home) }}">{{ s.product }}</a>
{% if alternates %}
    <nav class="site-header__langs" aria-label="{{ s.lang_nav_label }}">
{% for alt in alternates %}
{% if alt.current %}
      <span lang="{{ alt.html }}" aria-current="true">{{ alt.name }}</span>
{% else %}
      <a href="{{ alt.href }}" hreflang="{{ alt.html }}" lang="{{ alt.html }}">{{ alt.name }}</a>
{% endif %}
{% endfor %}
    </nav>
{% endif %}
  </div>
{% block masthead %}{% endblock %}
</header>
<main class="{% block main_class %}wrap{% endblock %}">
{% block content %}{% endblock %}
</main>
<footer class="site-footer">
  <div class="wrap">
    <nav class="site-footer__links" aria-label="{{ s.footer_label }}">
      <a href="{{ url(home ~ 'feed.xml') }}">{{ icon('rss') }} {{ s.rss }}</a>
      <a href="{{ config.newsletter }}">{{ icon('email-outline') }} {{ s.newsletter }}</a>
      <a href="{{ config.homepage }}">{{ icon('home-outline') }} {{ s.home }}</a>
{% if onion_url %}
      <a href="{{ onion_url }}">{{ icon('torproject') }} {{ s.onion }}</a>
{% endif %}
    </nav>
    <p>{{ s.license_before }}<a href="{{ s.license_url }}">CC-BY 4.0</a>{{ s.license_after }}</p>
{% if target.analytics %}
    <p>{{ s.analytics }}</p>
{% endif %}
  </div>
</footer>
</body>
</html>
