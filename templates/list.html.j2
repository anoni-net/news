{% extends "_layout.html.j2" %}
{% if kind == "index" and number == 1 %}
{% set page_title = "anoni.net 新聞導讀" %}
{% set page_description = "整理國際上隱私、匿名網路與網路審查的新聞，一則寫成一篇正體中文的導讀，附上原文與延伸閱讀。" %}
{% elif kind == "index" %}
{% set page_title = "第 " ~ number ~ " 頁 | anoni.net 新聞導讀" %}
{% set page_description = "anoni.net 新聞導讀的第 " ~ number ~ " 頁，依發布日期由新到舊排列。" %}
{% else %}
{% set page_title = heading ~ " | anoni.net 新聞導讀" %}
{% set page_description = heading ~ "，依發布日期由新到舊排列。" %}
{% endif %}
{% set og_title = page_title %}
{% set og_type = "website" %}
{% block content %}
<h1>{{ heading }}{% if number > 1 %}（第 {{ number }} 頁）{% endif %}</h1>
{% if kind == "index" and number == 1 %}
<p class="lead">整理國際上隱私、匿名網路與網路審查的新聞，一則寫成一篇正體中文的導讀。每篇附上原文，也連到<a href="{{ config.docs }}">文件站</a>的相關頁面。</p>
{% endif %}
{% if posts %}
<ol class="post-list">
{% for post in posts %}
  <li>
    <a class="post-list__title" href="{{ url(post.rel) }}">{{ post.title }}</a>
    <p class="post-list__meta"><time datetime="{{ post.created|iso }}">{{ post.created|ymd }}</time></p>
    <p class="post-list__description">{{ post.description }}</p>
  </li>
{% endfor %}
</ol>
{% else %}
<p>還沒有文章。</p>
{% endif %}
{% if prev_rel is not none or next_rel %}
<nav class="pager" aria-label="分頁">
{% if prev_rel is not none %}
  <a href="{{ url(prev_rel) }}" rel="prev">較新的文章</a>
{% endif %}
{% if next_rel %}
  <a href="{{ url(next_rel) }}" rel="next">較舊的文章</a>
{% endif %}
</nav>
{% endif %}
{% endblock %}
