{% extends "_layout.html.j2" %}
{% set front = kind == "index" and number == 1 %}
{% if front %}
{% set page_title = "anoni.net 新聞導讀" %}
{% set page_description = "整理國際上隱私、匿名網路與網路審查的新聞，一則寫成一篇正體中文的導讀，附上原文與延伸閱讀。" %}
{% elif kind == "index" %}
{% set page_title = "第 " ~ number ~ " 頁 | anoni.net 新聞導讀" %}
{% set page_description = "anoni.net 新聞導讀的第 " ~ number ~ " 頁，依發布日期由新到舊排列。" %}
{% else %}
{% set page_title = heading ~ " | anoni.net 新聞導讀" %}
{% set page_description = heading ~ "，依發布日期由新到舊排列。" %}
{% endif %}
{% set og_title = page_title %}
{% set og_type = "website" %}
{% block masthead %}
{% if front %}
  <div class="masthead">
    <h1 class="masthead__title">新聞導讀</h1>
    <p class="masthead__tagline">國際隱私、匿名網路與審查新聞，一則一篇的正體中文導讀，每篇都附上原文。</p>
{% if latest %}
    <p class="masthead__updated">最後更新 <time datetime="{{ latest.created|iso }}">{{ latest.created|ymd }}</time></p>
{% endif %}
  </div>
{% endif %}
{% endblock %}
{% block main_class %}list-wrap{% endblock %}
{% block content %}
{% if not front %}
<h1 class="list-heading">{{ heading }}{% if number > 1 %}（第 {{ number }} 頁）{% endif %}</h1>
{% endif %}
{% if posts %}
{% if featured %}
<section class="featured{% if featured_image %} featured--image{% endif %}" aria-labelledby="featured-heading">
  <h2 class="featured__label" id="featured-heading">焦點</h2>
{% if featured_image %}
  <img class="featured__image" src="{{ featured_image.src }}" alt="" width="{{ featured_image.width }}" height="{{ featured_image.height }}" decoding="async">
{% endif %}
  <div class="featured__text">
    <h3 class="featured__title"><a href="{{ url(featured.rel) }}">{{ featured.title }}</a></h3>
    <p class="featured__dek">{{ featured.description }}</p>
    <p class="featured__meta"><time datetime="{{ featured.created|iso }}">{{ featured.created|ymd }}</time>{% if featured|source_line %}<span>{{ featured|source_line }}</span>{% endif %}</p>
  </div>
</section>
{% endif %}
{% set items = posts %}
{% include "_timeline.html.j2" %}
{% else %}
<p class="empty">第一篇導讀還在準備中。可以先用 <a href="{{ url('feed.xml') }}">RSS</a> 訂閱，新文章發布時就會收到。</p>
{% endif %}
{% if prev_rel is not none or next_rel %}
<nav class="pager" aria-label="分頁">
{% if prev_rel is not none %}
  <a href="{{ url(prev_rel) }}" rel="prev">較新的文章</a>
{% endif %}
{% if next_rel %}
  <a href="{{ url(next_rel) }}" rel="next">較舊的文章</a>
{% endif %}
</nav>
{% endif %}
{% endblock %}
