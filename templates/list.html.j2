{% extends "_layout.html.j2" %}
{% set front = kind == "index" and number == 1 %}
{% if front %}
{% set page_title = s.site_name %}
{% set page_description = s.description %}
{% elif kind == "index" %}
{% set page_title = s.page_title.format(n=number) ~ " | " ~ s.site_name %}
{% set page_description = s.page_description.format(n=number) %}
{% else %}
{% set page_title = heading ~ " | " ~ s.site_name %}
{% set page_description = s.archive_description.format(heading=heading) %}
{% endif %}
{% set og_title = page_title %}
{% set og_type = "website" %}
{% block masthead %}
{% if front %}
  <div class="masthead">
    <h1 class="masthead__title">{{ s.product }}</h1>
    <p class="masthead__tagline">{{ s.tagline }}</p>
    <div class="masthead__bar">
{% if latest %}
      <p class="masthead__updated">{{ s.updated }} <time datetime="{{ latest.created|iso }}">{{ latest.created|ymd }}</time></p>
{% endif %}
      <p class="masthead__subscribe"><a href="{{ url(home ~ 'subscribe/') }}"{{ track("subscribe-click", channel="rss", where="masthead") }}>{{ icon('rss') }} {{ s.rss }}</a><a href="{{ s.newsletter_url }}"{{ track("subscribe-click", channel="newsletter", where="masthead") }}>{{ icon('email-outline') }} {{ s.newsletter }}</a><a href="{{ s.bluesky_url }}"{{ track("subscribe-click", channel="bluesky", where="masthead") }}>{{ icon('bluesky') }} {{ s.bluesky }}</a></p>
    </div>
  </div>
{% endif %}
{% endblock %}
{% block main_class %}list-wrap{% endblock %}
{% block content %}
{% if not front %}
<h1 class="list-heading">{{ heading }}{% if number > 1 %}{{ s.page_suffix.format(n=number) }}{% endif %}</h1>
{% endif %}
{% if days %}
{% if featured %}
<section class="featured{% if featured_image %} featured--image{% endif %}" aria-labelledby="featured-heading">
  <h2 class="featured__label" id="featured-heading">{{ s.featured }}</h2>
{% if featured_image %}
  <img class="featured__image" src="{{ featured_image.src }}" alt="" width="{{ featured_image.width }}" height="{{ featured_image.height }}" decoding="async">
{% endif %}
  <div class="featured__text">
    <h3 class="featured__title"><a href="{{ url(featured.rel) }}"{{ track("home-story-click", section="featured") }}>{{ featured.title }}</a></h3>
    <p class="featured__dek">{{ featured.description }}</p>
    <p class="featured__meta"><time datetime="{{ featured.created|iso }}">{{ featured.created|ymd }}</time>{% if featured|source_line %}<span>{{ featured|source_line }}</span>{% endif %}</p>
  </div>
</section>
{% endif %}
{% include "_timeline.html.j2" %}
{% else %}
<p class="empty">{{ s.empty_before }}<a href="{{ url(home ~ 'subscribe/') }}">{{ s.rss }}</a>{{ s.empty_after }}</p>
{% endif %}
{% if prev_rel is not none or next_rel %}
<nav class="pager" aria-label="{{ s.pagination_label }}">
{% if prev_rel is not none %}
  <a href="{{ url(prev_rel) }}" rel="prev">{{ s.newer_page }}</a>
{% endif %}
{% if next_rel %}
  <a href="{{ url(next_rel) }}" rel="next">{{ s.older_page }}</a>
{% endif %}
</nav>
{% endif %}
{% endblock %}
