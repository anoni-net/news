{% extends "_layout.html.j2" %}
{# 三個語系共用一頁，伺服器依路徑回同一個檔案。頁面框架用 zh-TW，內容三種語言各一段 #}
{% set page_title = s.not_found ~ " | " ~ s.site_name %}
{% set page_description = "找不到這個網址對應的頁面。" %}
{% set og_title = page_title %}
{% set og_type = "website" %}
{% block content %}
{% for v in versions %}
<section class="not-found" lang="{{ v.lang.html }}">
{% if loop.first %}
<h1>{{ v.s.not_found }}</h1>
{% else %}
<h2>{{ v.s.not_found }}</h2>
{% endif %}
<p>{{ v.s.not_found_before }}<a href="{{ url(v.lang.path) }}">{{ v.s.not_found_link }}</a>{{ v.s.not_found_after }}</p>
</section>
{% endfor %}
{% endblock %}
