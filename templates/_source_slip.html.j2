<aside class="source-slip" id="sources" aria-labelledby="source-slip-heading">
  <h2 class="source-slip__heading" id="source-slip-heading">{% if post.sources|length > 1 %}{{ s.sources_count.format(count=post.sources|length) }}{% else %}{{ s.sources }}{% endif %}</h2>
{% for source in post.sources %}
  <div class="source-slip__item">
    <p class="source-slip__title" lang="{{ 'zh-Hant' if source.title is cjk else 'en' }}"><a href="{{ source.url }}">{{ source.title }}</a></p>
{% if source.publisher or source.date %}
    <dl class="source-slip__meta">
{% if source.publisher %}
      <div><dt>{{ s.publisher }}</dt><dd>{{ source.publisher }}</dd></div>
{% endif %}
{% if source.date %}
      <div><dt>{{ s.source_date }}</dt><dd><time datetime="{{ source.date.isoformat() }}">{{ source.date|ymd }}</time></dd></div>
{% endif %}
    </dl>
{% endif %}
  </div>
{% endfor %}
</aside>
