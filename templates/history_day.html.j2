{% extends "_layout.html.j2" %}
{% block header_langs %}{% endblock %}
{# 導讀歷史的一個日期。快照照檔案的順序由舊到新排，往下讀就是一年一年增補上去的回看 #}
{% set day_label = day.calendar|md %}
{% set page_title = s.history_day_title.format(date=day_label) ~ " | " ~ s.site_name %}
{% set page_description = snapshots[-1].description %}
{% set og_title = s.history_day_title.format(date=day_label) %}
{% set og_type = "website" %}
{# 閱讀模式從 meta 取署名。沒有這一行時，Readability 會把每一段下方「寫於、導讀」那一行連同換行抓成署名 #}
{% block head %}
<meta name="author" content="{% for author in snapshots[-1].authors %}{{ author|author_name }}{% if not loop.last %}{{ s.list_sep }}{% endif %}{% endfor %}">
{% endblock %}
{% block main_class %}story-wrap{% endblock %}
{% block content %}
<article class="history-day">
  <header class="story__head">
    <p class="story__date"><a class="history-day__column" href="{{ url(home ~ 'history/') }}">{{ icon('history') }} {{ s.history }}</a></p>
    <h1 class="story__title">{{ day_label }}</h1>
    <p class="story__dek">{{ s.history_day_dek }}</p>
{# 日期頁的正文只有一兩段，字數低於閱讀模式的門檻（Readability 是 500 字）時，它會放寬條件重抓，
   role="navigation" 擋不住語系連結。包在 aside 裡，閱讀模式一律移除。aside 在 article 裡、沒有名稱，
   輔助科技不會把它當成地標 #}
  <aside>
{% with langs_class = "story__langs" %}{% include "_other_langs.html.j2" %}{% endwith %}
  </aside>
  </header>
{% for snap in snapshots %}
  <section class="snapshot" id="{{ snap.anchor }}" aria-labelledby="{{ snap.anchor }}-title">
    <h2 class="snapshot__year">{{ snap.year }}</h2>
    <h3 class="snapshot__title" id="{{ snap.anchor }}-title">{{ snap.title }}</h3>
    <p class="snapshot__event"><time datetime="{{ snap.event.isoformat() }}">{{ snap.event|ymd }}</time></p>
    <div class="snapshot__body content">
{{ contents[snap.year]|safe }}
    </div>
{% if snap.also %}
    {# 寫稿時查過、沒選上的同一天的事，每則一句加一個來源。跟著寫下它的那一年，舊的同樣保留原樣 #}
    <div class="snapshot__also">
      <h4 class="snapshot__also-heading">{{ s.history_also }}</h4>
      <ul class="snapshot__also-list">
{% for item in snap.also %}
        <li><time class="snapshot__also-year" datetime="{{ item.event.isoformat() }}">{{ s.history_event_year.format(year=item.event.year) }}</time> {{ item.text }} <span class="snapshot__also-source">{{ s.history_also_source }}<a href="{{ item.source.url }}" title="{{ item.source.title }}">{{ item.source.publisher }}</a></span></li>
{% endfor %}
      </ul>
    </div>
{% endif %}
    {# 原文與署名放在 aside，閱讀模式只留年份、標題、事件日期與那一段，跟文章頁的原文條相同 #}
    <aside class="snapshot__meta">
    <p class="snapshot__sources-label">{{ s.sources }}</p>
    <ul class="snapshot__sources">
{% for source in snap.sources %}
      <li><a href="{{ source.url }}" lang="{{ 'zh-Hant' if source.title is cjk else 'en' }}">{% if source.icon %}<img src="{{ url('assets/' ~ source.icon) }}" width="16" height="16" alt="" loading="lazy" decoding="async">{% else %}{{ icon('web') }}{% endif %}{{ source.title }}</a>{% if source.publisher or source.date %}<span class="snapshot__publisher">{{ source.publisher or "" }}{% if source.publisher and source.date %}{{ s.list_sep }}{% endif %}{% if source.date %}<time datetime="{{ source.date.isoformat() }}">{{ source.date|ymd }}</time>{% endif %}</span>{% endif %}</li>
{% endfor %}
    </ul>
    <p class="snapshot__byline">
      <span>{{ s.history_written }} <time datetime="{{ snap.created|iso }}">{{ snap.created|ymd }}</time></span>
      <span>{{ s.byline }}{% for author in snap.authors %}{% if author.url %}<a href="{{ author.url }}" rel="author">{{ author|author_name }}</a>{% else %}{{ author|author_name }}{% endif %}{% if not loop.last %}{{ s.list_sep }}{% endif %}{% endfor %}</span>
{% if snap.updated %}
      <span>{{ s.corrected }} <time datetime="{{ snap.updated|iso }}">{{ snap.updated|ymd }}</time></span>
{% endif %}
    </p>
    </aside>
  </section>
{% endfor %}
</article>
<nav class="pager pager--story" aria-label="{{ s.history_nav_label }}">
{% if earlier %}
  <a class="pager__item pager__item--newer" href="{{ url(earlier.rel) }}"><span class="pager__label">{{ icon('arrow-left') }} {{ s.history_prev }}</span> <span class="pager__title">{{ earlier.calendar|md }}</span></a>
{% endif %}
{% if later %}
  <a class="pager__item pager__item--older" href="{{ url(later.rel) }}"><span class="pager__label">{{ s.history_next }} {{ icon('arrow-right') }}</span> <span class="pager__title">{{ later.calendar|md }}</span></a>
{% endif %}
  <a class="pager__all" href="{{ url(home ~ 'history/') }}">{{ s.history_all }}</a>
</nav>
{% endblock %}
