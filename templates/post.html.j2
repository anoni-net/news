{% extends "_layout.html.j2" %}
{% block header_langs %}{% endblock %}
{% set page_title = post.title ~ " | " ~ s.site_name %}
{% set page_description = post.description %}
{% set og_title = post.title %}
{% set og_type = "article" %}
{% block head %}
<meta property="article:published_time" content="{{ post.created|iso }}">
{% if post.updated %}
<meta property="article:modified_time" content="{{ post.updated|iso }}">
{% endif %}
{{ jsonld|safe }}
{% if target.read_aloud %}
<script defer src="{{ asset('js/read-aloud.js') }}" data-anoni="read-aloud"></script>
{% endif %}
{% endblock %}
{% block main_class %}story-wrap{% endblock %}
{% block content %}
<article class="story">
  <header class="story__head">
    <p class="story__date">{% if post.categories %}{% with cat = post.categories[0] %}{% include "_category.html.j2" %}{% endwith %} <span aria-hidden="true">·</span> {% endif %}<time datetime="{{ post.created|iso }}">{{ post.created|full_date }}</time></p>
    <h1 class="story__title">{{ post.title }}</h1>
    <p class="story__dek">{{ post.description }}</p>
    <p class="story__byline">
{% set line = post|source_line %}
{# 出處行列出的網站，圖示並排成一串放在行首，跟下方原文區塊的圖示呼應 #}
{% set icons = post|source_icons %}
      <span class="story__sources"><a href="#sources">{% if icons %}<span class="favicon-stack">{% for rel in icons %}{% if rel %}<img src="{{ url('assets/' ~ rel) }}" width="16" height="16" alt="" decoding="async">{% else %}{{ icon('web') }}{% endif %}{% endfor %}</span>{% else %}{{ icon('file-document-multiple-outline') }}{% endif %} <span>{{ line if line else s.sources }}</span></a></span>
      <span>{{ s.byline }}{% for author in post.authors %}{% if author.url %}<a href="{{ author.url }}" rel="author">{{ author|author_name }}</a>{% else %}{{ author|author_name }}{% endif %}{% if not loop.last %}{{ s.list_sep }}{% endif %}{% endfor %}</span>
{% if post.updated %}
      <span>{{ s.corrected }} <time datetime="{{ post.updated|iso }}">{{ post.updated|ymd }}</time></span>
{% endif %}
    </p>
{% with langs_class = "story__langs" %}{% include "_other_langs.html.j2" %}{% endwith %}
{# 朗讀按鈕，規則見 SPEC.md「朗讀按鈕」。預設 hidden，read-aloud.js 找到本機語音才顯示，沒有 JavaScript 時看不到。
   包在 aside 裡，閱讀模式不會把按鈕與說明當成正文 #}
{% if target.read_aloud %}
    <aside class="listen" data-read-aloud hidden>
      <button type="button" class="listen__button" data-state="idle" data-label-idle="{{ s.listen }}" data-label-playing="{{ s.listen_pause }}" data-label-paused="{{ s.listen_resume }}"{{ track("listen-click") }}><span class="listen__play">{{ icon('volume-high') }}</span><span class="listen__pause">{{ icon('pause') }}</span> <span data-label>{{ s.listen }}</span></button>
      {# 語音的選項由 read-aloud.js 依裝置上的本機語音填入，依語言分組，組名來自 data-group-*，只有一個時不顯示。速度的選項寫在這裡 #}
      <span class="listen__options">
      <label class="listen__field" data-voice-field hidden><span>{{ s.listen_voice }}</span> <select class="listen__select" data-voice data-group-tw="{{ s.listen_group_tw }}" data-group-cn="{{ s.listen_group_cn }}" data-group-zh="{{ s.listen_group_zh }}" data-group-yue="{{ s.listen_group_yue }}"></select></label>
      <label class="listen__field"><span>{{ s.listen_rate }}</span> <select class="listen__select" data-rate>{% for rate in ["0.8", "1", "1.25", "1.5"] %}<option value="{{ rate }}"{% if rate == "1" %} selected{% endif %}>{{ s.listen_rate_option.format(rate=rate) }}</option>{% endfor %}</select></label>
      </span>
      <p class="listen__note">{{ s.listen_note }}</p>
    </aside>
{% endif %}
{# 這件事有更新的導讀時，在標題區就提示，從搜尋或舊連結進來的讀者第一眼就知道內容可能已經不是最新 #}
{% if followup %}
    <p class="story__followup">{{ s.followup }}<a href="{{ url(followup.rel) }}">{{ followup.title }}</a>{{ s.followup_date.format(date=followup.created|ymd) }}</p>
{% endif %}
  </header>
  <div class="story__body content">
{{ content|safe }}
  </div>
{# 原文清單在 HTML 裡排在內文之後：手機照順序落在文末，桌機由 grid 放到右欄 #}
{% include "_source_slip.html.j2" %}
</article>
{% if thread %}
{% include "_thread.html.j2" %}
{% endif %}
{% if related %}
{% include "_related.html.j2" %}
{% endif %}
{# 從社群平台點進來的讀者看不到首頁的刊頭，讀完一篇時在這裡給訂閱的入口 #}
<p class="subscribe">{{ s.subscribe }}<a href="{{ url(home ~ 'subscribe/') }}"{{ track("subscribe-click", channel="rss", where="article") }}>{{ icon('rss') }} <span>{{ s.rss }}</span></a>{{ s.subscribe_sep }}<a href="{{ s.newsletter_url }}"{{ track("subscribe-click", channel="newsletter", where="article") }}>{{ icon('email-outline') }} <span>{{ s.newsletter_inline }}</span></a>{{ s.subscribe_sep_last }}<a href="{{ s.bluesky_url }}"{{ track("subscribe-click", channel="bluesky", where="article") }}>{{ icon('bluesky') }} <span>{{ s.bluesky_inline }}</span></a></p>
{# 讀完一篇接著讀相鄰的文章。用「較新、較舊」跟列表頁的翻頁說法一致，帶標題讓讀者知道點下去是什麼 #}
<nav class="pager pager--story" aria-label="{{ s.story_nav_label }}">
{% if newer %}
  <a class="pager__item pager__item--newer" href="{{ url(newer.rel) }}"><span class="pager__label">{{ icon('arrow-left') }} {{ s.newer_story }}</span> <span class="pager__title">{{ newer.title }}</span></a>
{% endif %}
{% if older %}
  <a class="pager__item pager__item--older" href="{{ url(older.rel) }}"><span class="pager__label">{{ s.older_story }} {{ icon('arrow-right') }}</span> <span class="pager__title">{{ older.title }}</span></a>
{% endif %}
  <a class="pager__all" href="{{ url(home) }}">{{ s.all_stories }}</a>
</nav>
{% endblock %}
